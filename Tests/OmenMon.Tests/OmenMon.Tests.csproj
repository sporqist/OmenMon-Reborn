<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- EcDiffScanner is deliberately a pure, dependency-free static class so the
       RPM-encoding heuristics can be compiled directly into this .NET 10 test
       project (the main project is .NET Framework 4.8 and cannot be referenced).
       If this include breaks, someone added an App/Hardware dependency to the
       scanner - keep it pure instead. -->
  <ItemGroup>
    <Compile Include="..\..\Hardware\BiosData.cs" Link="Hardware\BiosData.cs" />
    <Compile Include="..\..\Hardware\EcDiffScanner.cs" Link="Hardware\EcDiffScanner.cs" />
    <Compile Include="..\..\Library\Conv.cs" Link="Library\Conv.cs" />
    <Compile Include="..\..\Library\FanDataPipeServer.cs" Link="Library\FanDataPipeServer.cs" />
  </ItemGroup>

</Project>
