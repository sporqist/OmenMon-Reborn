{
  "schema": 1,
  "about": [
    "The fan-safety rules of the restructuring plan (PLAN.md section 3, 8BAC) as data: inputs -> expected command or verdict.",
    "SafetyVectorTests runs every vector against the current classes (FanSafetyGuard, FanSafetyPolicy, GpuReading, ThermalPanicState;",
    "board vectors: FanArray + Platform over the simulated 8BAC in SafetyLoop). The extracted core must pass the same table.",
    "A vector records what the code does today. 'disputed' marks a disagreement with PLAN (code behaviour kept), 'note' a finding."
  ],
  "conventions": {
    "time": "'age' = seconds before the moment of evaluation; history 'at' = seconds relative to it (negative = earlier)",
    "levels": "[cpu, gpu] in rpm/100; 255 = 0xFF, the 'no change' sentinel",
    "policy": "FanSafetyPolicy defaults (floor 20/22, cool < 50 C, reading max age 45 s, Fan Off 15 min, quiet 150 s, warm curve 60:30/33,70:40/43,80:60/63) unless overridden",
    "panic": "threshold 90, hysteresis 5 (the installed 8BAC configuration) unless overridden",
    "board": "the simulated 8BAC (Fake8BacBios): 0x2E only takes effect within 30 s after a 0x10, expires 124 s after the last 0x2E/0x10, BIOS curve 24/26, fan table maximum 52/55 (the real board: 60/63); the default warm curve is used",
    "calls": "board 'calls' lists the write-type BIOS calls since the previous expect (0x10, 0x2E, 0x1A, 0x27, 0x32); 'writes' only the 0x2E levels"
  },
  "rules": [
    { "tag": "readings-stale",   "plan": "3 Safety rules", "text": "Readings older than the max age are unknown, never 0 C" },
    { "tag": "readings-invalid", "plan": "3 Safety rules", "text": "A failed, 0 C or implausible read is no reading: the last valid one ages out" },
    { "tag": "gpu-state",        "plan": "3 Safety rules", "text": "The GPU counts if it reads: fresh, parked (successful 0 reads) or unknown (failed reads after a reading)" },
    { "tag": "cool",             "plan": "3 Safety rules", "text": "Known cool = a fresh, valid CPU reading < 50 C, and the GPU too if it reads" },
    { "tag": "floor",            "plan": "3 Safety rules", "text": "Floor 20/22 whenever the system is not known to be cool, for every source" },
    { "tag": "warm-curve",       "plan": "3 Safety rules", "text": "One-shot (manual) levels while warm: 60 C -> 30/33, 70 C -> 40/43, 80 C -> 60/63; programs are not raised by it" },
    { "tag": "warm-hottest",     "plan": "3 Safety rules", "text": "The hottest of CPU and GPU decides the warm-curve step; an unknown temperature gets the top step" },
    { "tag": "zero-refused",     "plan": "3 Hard facts",   "text": "0x2E [0,0] is fans OFF: never sent while the system is not known to be cool" },
    { "tag": "off-time-limit",   "plan": "4 Rule 3",       "text": "A manual level below the floor (Fan Off) is allowed only while known cool and for at most 15 min" },
    { "tag": "supervision",      "plan": "3 Safety rules", "text": "A held level that is no longer allowed (warmed up, sensors stopped reading, time up) is raised on the next pass" },
    { "tag": "panic-enter",      "plan": "3 Safety rules", "text": "Panic starts at the threshold" },
    { "tag": "panic-level",      "plan": "3 Safety rules", "text": "In panic every write is raised to the fan-table maximum and re-sent on every pass" },
    { "tag": "panic-clear",      "plan": "3 Safety rules", "text": "Panic clears at threshold - hysteresis, and then restores the request or hands back" },
    { "tag": "panic-missing",    "plan": "3 Safety rules", "text": "A missing reading never changes the panic state (an incomplete one may start it, never end it)" },
    { "tag": "panic-latency",    "plan": "3 Safety rules", "text": "Panic reaches the fan-table maximum within 16 s of the threshold" },
    { "tag": "handback-level",   "plan": "3 Safety rules", "text": "Hand-back writes a safe last level: never below the floor, and at least the warm curve while warm" },
    { "tag": "handback-silence", "plan": "3 Safety rules", "text": "After the hand-back: no 0x2E and no 0x10 for >= 150 s, so the level expires and the BIOS curve takes over" },
    { "tag": "no-change",        "plan": "3 Hard facts",   "text": "255/255 is not a release: it passes the filter untouched, and a 255/255 request is handled as a hand-back" },
    { "tag": "arming",           "plan": "3 BIOS WMI",     "text": "0x2E is ignored unless armed by a 0x10 within ~30 s; safety writes (supervision, panic, hand-back) arm themselves" },
    { "tag": "expiry",           "plan": "3 BIOS WMI",     "text": "A level expires ~124 s after the last 0x2E/0x10 and the BIOS curve resumes" }
  ],
  "notExpressible": [
    { "tag": "panic-latency", "why": "The pass cadence (sample every UpdateIconInterval = 3 ticks of 1 s while panic is enabled) lives in GuiMonitor.Pass, which needs the GUI. Vectors and the property test check 'panic within one pass of the reading'; the 16 s bound itself is only checked on hardware (P5)." }
  ],
  "vectors": [

    { "id": "stale-01", "covers": "readings-stale", "kind": "guard", "rule": "A CPU reading exactly at the max age (45 s) is still fresh",
      "cpu": { "c": 40, "age": 45 }, "op": "isCool", "expect": true },
    { "id": "stale-02", "covers": "readings-stale", "kind": "guard", "rule": "A CPU reading 1 s past the max age is unknown: not cool",
      "cpu": { "c": 40, "age": 46 }, "op": "isCool", "expect": false },
    { "id": "stale-03", "covers": "readings-stale", "kind": "guard", "rule": "A stale CPU reading gives no hottest temperature (unknown, not 0 C)",
      "cpu": { "c": 40, "age": 46 }, "op": "hottest", "expect": null },
    { "id": "stale-04", "covers": "readings-stale", "kind": "guard", "rule": "A stale CPU reading is an unknown temperature: a manual 0/0 gets the top curve step",
      "cpu": { "c": 40, "age": 46 }, "op": "filter", "level": [0, 0], "source": "manual", "expect": [60, 63] },
    { "id": "stale-05", "covers": "readings-stale", "kind": "guard", "rule": "The max age comes from the policy (10 s): fresh at 10 s",
      "policy": { "readingMaxAgeS": 10 }, "cpu": { "c": 40, "age": 10 }, "op": "isCool", "expect": true },
    { "id": "stale-06", "covers": "readings-stale", "kind": "guard", "rule": "The max age comes from the policy (10 s): unknown at 11 s",
      "policy": { "readingMaxAgeS": 10 }, "cpu": { "c": 40, "age": 11 }, "op": "isCool", "expect": false },
    { "id": "stale-07", "covers": "cool", "kind": "guard", "rule": "No CPU reading is never cool, even with a cool GPU",
      "gpu": { "c": 30, "age": 0 }, "op": "isCool", "expect": false },

    { "id": "gpu-01", "covers": "gpu-state", "kind": "guard", "rule": "A GPU that never read (no sensor, or parked since start) counts as parked",
      "op": "gpuState", "expect": "Parked" },
    { "id": "gpu-02", "covers": "gpu-state", "kind": "guard", "rule": "A GPU reading at the max age is fresh",
      "gpu": { "c": 70, "age": 45 }, "op": "gpuState", "expect": "Fresh" },
    { "id": "gpu-03", "covers": "gpu-state", "kind": "guard", "rule": "A GPU that read before and now only fails is unknown, not parked",
      "gpu": { "c": 70, "age": 46 }, "op": "gpuState", "expect": "Unknown" },
    { "id": "gpu-04", "covers": "gpu-state", "kind": "guard", "rule": "A fresh valid GPU reading wins over a later 0 (a single 0 can be a glitch)",
      "gpu": { "c": 70, "age": 10, "zeroAge": 5 }, "op": "gpuState", "expect": "Fresh" },
    { "id": "gpu-05", "covers": "gpu-state", "kind": "guard", "rule": "A stale GPU reading with a fresh successful 0 is parked",
      "gpu": { "c": 70, "age": 60, "zeroAge": 20 }, "op": "gpuState", "expect": "Parked" },
    { "id": "gpu-06", "covers": "gpu-state", "kind": "guard", "rule": "A parked GPU whose 0 reads stopped too is unknown",
      "gpu": { "c": 70, "age": 86, "zeroAge": 46 }, "op": "gpuState", "expect": "Unknown" },
    { "id": "gpu-07", "covers": "gpu-state", "kind": "guard", "rule": "A 0 from before the last reading does not park a stale GPU",
      "gpu": { "c": 70, "age": 46, "zeroAge": 47 }, "op": "gpuState", "expect": "Unknown" },

    { "id": "cool-01", "covers": "cool", "kind": "guard", "rule": "CPU exactly at the cool temperature (50 C) is warm",
      "cpu": { "c": 50, "age": 0 }, "op": "isCool", "expect": false },
    { "id": "cool-02", "covers": "cool", "kind": "guard", "rule": "CPU 49 C with a GPU that never read is cool",
      "cpu": { "c": 49, "age": 0 }, "op": "isCool", "expect": true },
    { "id": "cool-03", "covers": "cool", "kind": "guard", "rule": "A fresh GPU at 50 C makes a cool CPU warm",
      "cpu": { "c": 40, "age": 0 }, "gpu": { "c": 50, "age": 0 }, "op": "isCool", "expect": false },
    { "id": "cool-04", "covers": "cool", "kind": "guard", "rule": "CPU 40 C and a fresh GPU at 49 C are cool",
      "cpu": { "c": 40, "age": 0 }, "gpu": { "c": 49, "age": 0 }, "op": "isCool", "expect": true },
    { "id": "cool-05", "covers": "cool", "kind": "guard", "rule": "A parked GPU leaves the CPU to decide: cool",
      "cpu": { "c": 40, "age": 0 }, "gpu": { "c": 55, "age": 60, "zeroAge": 5 }, "op": "isCool", "expect": true },
    { "id": "cool-06", "covers": "cool", "kind": "guard", "rule": "An unknown GPU (failed reads after a reading) is never cool",
      "cpu": { "c": 40, "age": 0 }, "gpu": { "c": 45, "age": 46 }, "op": "isCool", "expect": false },
    { "id": "cool-07", "covers": "cool", "kind": "guard", "rule": "A fresh warm GPU reading with a later 0 is still warm",
      "cpu": { "c": 40, "age": 0 }, "gpu": { "c": 55, "age": 3, "zeroAge": 0 }, "op": "isCool", "expect": false },
    { "id": "cool-08", "covers": "cool", "kind": "guard", "rule": "The cool temperature comes from the policy",
      "policy": { "coolTemperature": 40 }, "cpu": { "c": 45, "age": 0 }, "op": "isCool", "expect": false },

    { "id": "floor-01", "covers": "floor", "kind": "guard", "rule": "Manual 0/0 at 55 C (warm, below the first curve step) is raised to the floor 20/22",
      "cpu": { "c": 55, "age": 0 }, "op": "filter", "level": [0, 0], "source": "manual", "expect": [20, 22] },
    { "id": "floor-02", "covers": "floor", "kind": "guard", "rule": "Manual 0/0 at exactly 50 C gets the floor",
      "cpu": { "c": 50, "age": 0 }, "op": "filter", "level": [0, 0], "source": "manual", "expect": [20, 22] },
    { "id": "floor-03", "covers": "floor", "kind": "guard", "rule": "The floor is per fan: [0, 35] at 55 C becomes [20, 35]",
      "cpu": { "c": 55, "age": 0 }, "op": "filter", "level": [0, 35], "source": "manual", "expect": [20, 35] },
    { "id": "floor-04", "covers": "floor", "kind": "guard", "rule": "Program levels get the floor too: program 0/0 at 55 C becomes 20/22",
      "cpu": { "c": 55, "age": 0 }, "op": "filter", "level": [0, 0], "source": "program", "expect": [20, 22] },
    { "id": "floor-05", "covers": "floor", "kind": "guard", "rule": "An unknown GPU raises 0/0 to the floor (flat floor, no curve)",
      "policy": { "warmCurve": "none" }, "cpu": { "c": 40, "age": 0 }, "gpu": { "c": 45, "age": 46 }, "op": "filter", "level": [0, 0], "source": "manual", "expect": [20, 22] },
    { "id": "floor-06", "covers": "floor", "kind": "guard", "rule": "The floor comes from the policy (25/28)",
      "policy": { "floorCpu": 25, "floorGpu": 28 }, "cpu": { "c": 55, "age": 0 }, "op": "filter", "level": [0, 0], "source": "manual", "expect": [25, 28] },
    { "id": "floor-07", "covers": "floor", "kind": "guard", "rule": "Levels above the floor pass a program write unchanged, however hot",
      "cpu": { "c": 90, "age": 0 }, "op": "filter", "level": [45, 50], "source": "program", "expect": [45, 50] },
    { "id": "floor-08", "covers": "floor", "kind": "guard", "rule": "No CPU reading at all raises a program 0/0 to the floor",
      "op": "filter", "level": [0, 0], "source": "program", "expect": [20, 22] },

    { "id": "zero-01", "covers": "zero-refused", "kind": "guard", "rule": "Manual 0/0 while known cool (49 C) passes: Fan Off",
      "cpu": { "c": 49, "age": 0 }, "op": "filter", "level": [0, 0], "source": "manual", "expect": [0, 0],
      "note": "The code sends 0/0 while known cool (Fan Off, PLAN 4 rule 3: kept or not is Marius's decision). CLAUDE.md says 'never send 0/0 in code'; the two need reconciling before SafeLevel is designed." },
    { "id": "zero-02", "covers": "zero-refused", "kind": "guard", "rule": "Program 0/0 while known cool passes (a 0/0 curve row)",
      "cpu": { "c": 45, "age": 0 }, "op": "filter", "level": [0, 0], "source": "program", "expect": [0, 0],
      "note": "Program levels below the floor have no time limit while cool. The installed 'Power' program has 0/0 rows below 36 C." },
    { "id": "zero-03", "covers": "zero-refused", "kind": "guard", "rule": "Manual 0/0 with a cool CPU and a parked GPU passes",
      "cpu": { "c": 40, "age": 0 }, "gpu": { "c": 55, "age": 60, "zeroAge": 5 }, "op": "filter", "level": [0, 0], "source": "manual", "expect": [0, 0] },
    { "id": "zero-04", "covers": "zero-refused", "kind": "guard", "rule": "Manual 0/0 with a cool CPU and a fresh warm GPU is refused (20/22)",
      "cpu": { "c": 40, "age": 0 }, "gpu": { "c": 55, "age": 0 }, "op": "filter", "level": [0, 0], "source": "manual", "expect": [20, 22] },

    { "id": "warm-01", "covers": "warm-curve", "kind": "guard", "rule": "Manual 0/0 at 59 C: below the first step, only the floor",
      "cpu": { "c": 59, "age": 0 }, "op": "filter", "level": [0, 0], "source": "manual", "expect": [20, 22] },
    { "id": "warm-02", "covers": "warm-curve", "kind": "guard", "rule": "Manual 0/0 at 60 C gets 30/33",
      "cpu": { "c": 60, "age": 0 }, "op": "filter", "level": [0, 0], "source": "manual", "expect": [30, 33] },
    { "id": "warm-03", "covers": "warm-curve", "kind": "guard", "rule": "Manual 0/0 at 69 C still gets 30/33",
      "cpu": { "c": 69, "age": 0 }, "op": "filter", "level": [0, 0], "source": "manual", "expect": [30, 33] },
    { "id": "warm-04", "covers": "warm-curve", "kind": "guard", "rule": "Manual 0/0 at 70 C gets 40/43",
      "cpu": { "c": 70, "age": 0 }, "op": "filter", "level": [0, 0], "source": "manual", "expect": [40, 43] },
    { "id": "warm-05", "covers": "warm-curve", "kind": "guard", "rule": "Manual 0/0 at 79 C still gets 40/43",
      "cpu": { "c": 79, "age": 0 }, "op": "filter", "level": [0, 0], "source": "manual", "expect": [40, 43] },
    { "id": "warm-06", "covers": "warm-curve", "kind": "guard", "rule": "Manual 0/0 at 80 C gets 60/63",
      "cpu": { "c": 80, "age": 0 }, "op": "filter", "level": [0, 0], "source": "manual", "expect": [60, 63] },
    { "id": "warm-07", "covers": "warm-curve", "kind": "guard", "rule": "A manual level above the curve passes unchanged",
      "cpu": { "c": 85, "age": 0 }, "op": "filter", "level": [65, 70], "source": "manual", "expect": [65, 70] },
    { "id": "warm-08", "covers": "warm-curve", "kind": "guard", "rule": "The curve raises each fan on its own: [45, 40] at 75 C becomes [45, 43]",
      "cpu": { "c": 75, "age": 0 }, "op": "filter", "level": [45, 40], "source": "manual", "expect": [45, 43] },
    { "id": "warm-09", "covers": "warm-curve", "kind": "guard", "rule": "Programs are not raised by the curve, only by the floor (0/0 at 85 C -> 20/22)",
      "cpu": { "c": 85, "age": 0 }, "op": "filter", "level": [0, 0], "source": "program", "expect": [20, 22] },
    { "id": "warm-10", "covers": "warm-curve", "kind": "guard", "rule": "Warm curve 'none': only the flat floor while warm",
      "policy": { "warmCurve": "none" }, "cpu": { "c": 85, "age": 0 }, "op": "filter", "level": [0, 0], "source": "manual", "expect": [20, 22] },
    { "id": "warm-11", "covers": "supervision", "kind": "guard", "rule": "A held manual level is raised by supervision as it warms (30/33 at 75 C -> 40/43)",
      "cpu": { "c": 75, "age": 0 }, "history": [ { "at": -10, "request": [30, 33], "write": [30, 33], "source": "manual" } ],
      "op": "supervise", "expect": [40, 43] },
    { "id": "warm-12", "covers": "supervision", "kind": "guard", "rule": "A held program level above the floor is left alone at 85 C",
      "cpu": { "c": 85, "age": 0 }, "history": [ { "at": -10, "request": [30, 30], "write": [30, 30], "source": "program" } ],
      "op": "supervise", "expect": null },

    { "id": "hot-01", "covers": "warm-hottest", "kind": "guard", "rule": "The hotter GPU decides: CPU 64 C, GPU 72 C -> 40/43",
      "cpu": { "c": 64, "age": 0 }, "gpu": { "c": 72, "age": 0 }, "op": "filter", "level": [0, 0], "source": "manual", "expect": [40, 43] },
    { "id": "hot-02", "covers": "warm-hottest", "kind": "guard", "rule": "The measured case: CPU 72 C, GPU 86 C -> 60/63",
      "cpu": { "c": 72, "age": 0 }, "gpu": { "c": 86, "age": 0 }, "op": "filter", "level": [0, 0], "source": "manual", "expect": [60, 63] },
    { "id": "hot-03", "covers": "warm-hottest", "kind": "guard", "rule": "No CPU reading: unknown, the top step 60/63",
      "op": "filter", "level": [0, 0], "source": "manual", "expect": [60, 63] },
    { "id": "hot-04", "covers": "warm-hottest", "kind": "guard", "rule": "An unknown GPU with a CPU at 55 C: the top step 60/63",
      "cpu": { "c": 55, "age": 0 }, "gpu": { "c": 55, "age": 46 }, "op": "filter", "level": [0, 0], "source": "manual", "expect": [60, 63] },
    { "id": "hot-05", "covers": "warm-hottest", "kind": "guard", "rule": "A parked GPU with a CPU at 55 C: judged on the CPU, the floor",
      "cpu": { "c": 55, "age": 0 }, "gpu": { "c": 55, "age": 46, "zeroAge": 0 }, "op": "filter", "level": [0, 0], "source": "manual", "expect": [20, 22] },
    { "id": "hot-06", "covers": "warm-hottest", "kind": "guard", "rule": "Hottest is the higher of a fresh CPU and a fresh GPU",
      "cpu": { "c": 64, "age": 0 }, "gpu": { "c": 72, "age": 0 }, "op": "hottest", "expect": 72 },
    { "id": "hot-07", "covers": "warm-hottest", "kind": "guard", "rule": "Hottest ignores a parked GPU's old value",
      "cpu": { "c": 64, "age": 0 }, "gpu": { "c": 72, "age": 50, "zeroAge": 1 }, "op": "hottest", "expect": 64 },
    { "id": "hot-08", "covers": "warm-hottest", "kind": "guard", "rule": "Hottest is unknown while the GPU is unknown",
      "cpu": { "c": 64, "age": 0 }, "gpu": { "c": 72, "age": 50 }, "op": "hottest", "expect": null },

    { "id": "limit-01", "covers": "off-time-limit", "kind": "guard", "rule": "Fan Off held 14 min while cool is left alone",
      "cpu": { "c": 40, "age": 0 }, "history": [ { "at": -840, "request": [0, 0], "write": [0, 0], "source": "manual" } ],
      "op": "supervise", "expect": null },
    { "id": "limit-02", "covers": "off-time-limit", "kind": "guard", "rule": "Fan Off held 15 min while cool is raised to the floor",
      "cpu": { "c": 40, "age": 0 }, "history": [ { "at": -900, "request": [0, 0], "write": [0, 0], "source": "manual" } ],
      "op": "supervise", "expect": [20, 22] },
    { "id": "limit-03", "covers": "off-time-limit", "kind": "guard", "rule": "After 15 min below the floor a manual 0/0 request is floored, even while cool",
      "cpu": { "c": 40, "age": 0 }, "history": [ { "at": -900, "request": [0, 0], "write": [0, 0], "source": "manual" } ],
      "op": "filter", "level": [0, 0], "source": "manual", "expect": [20, 22] },
    { "id": "limit-04", "covers": "off-time-limit", "kind": "guard", "rule": "The limit counts from the first write below the floor, across later manual writes below it",
      "cpu": { "c": 40, "age": 0 }, "history": [
        { "at": -900, "request": [0, 0], "write": [0, 0], "source": "manual" },
        { "at": -300, "request": [10, 10], "write": [10, 10], "source": "manual" } ],
      "op": "supervise", "expect": [20, 22] },
    { "id": "limit-05", "covers": "off-time-limit", "kind": "guard", "rule": "The limit comes from the policy (5 min)",
      "policy": { "belowFloorMaxMinutes": 5 }, "cpu": { "c": 40, "age": 0 }, "history": [ { "at": -300, "request": [0, 0], "write": [0, 0], "source": "manual" } ],
      "op": "supervise", "expect": [20, 22] },
    { "id": "limit-06", "covers": "off-time-limit", "kind": "guard", "rule": "Program levels below the floor have no time limit while cool (2 h)",
      "cpu": { "c": 40, "age": 0 }, "history": [ { "at": -7200, "request": [0, 0], "write": [0, 0], "source": "program" } ],
      "op": "supervise", "expect": null,
      "note": "PLAN 4 rule 3 limits Fan Off to 15 min; a program's 0/0 row is unlimited while cool. Not a contradiction of section 3, but a question for SafeLevel.Off." },
    { "id": "limit-07", "covers": "off-time-limit", "kind": "guard", "rule": "Once the limit raised Fan Off to the floor, a new Fan Off request starts a new 15 min",
      "cpu": { "c": 40, "age": 0 }, "history": [
        { "at": -960, "request": [0, 0], "write": [0, 0], "source": "manual" },
        { "at": -60, "supervised": [20, 22] } ],
      "op": "filter", "level": [0, 0], "source": "manual", "expect": [0, 0],
      "note": "The 15 min are per request: re-requesting Fan Off after the raise gives another 15 min (and any caller that re-applies a stored Fan Off, e.g. a preset on a power change, renews it)." },

    { "id": "sup-01", "covers": "supervision", "kind": "guard", "rule": "A held Fan Off needs supervision",
      "cpu": { "c": 40, "age": 0 }, "history": [ { "at": -10, "request": [0, 0], "write": [0, 0], "source": "manual" } ],
      "op": "needsSupervision", "expect": true },
    { "id": "sup-02", "covers": "supervision", "kind": "guard", "rule": "A held program level above the floor needs no supervision",
      "cpu": { "c": 60, "age": 0 }, "history": [ { "at": -10, "request": [30, 30], "write": [30, 30], "source": "program" } ],
      "op": "needsSupervision", "expect": false },
    { "id": "sup-03", "covers": "supervision", "kind": "guard", "rule": "A held Fan Off is raised to the floor once it warms to 58 C",
      "cpu": { "c": 58, "age": 0 }, "history": [ { "at": -30, "request": [0, 0], "write": [0, 0], "source": "manual" } ],
      "op": "supervise", "expect": [20, 22] },
    { "id": "sup-04", "covers": "supervision", "kind": "guard", "rule": "A held Fan Off is raised once the CPU reading is stale (unknown: top step)",
      "cpu": { "c": 40, "age": 46 }, "history": [ { "at": -60, "request": [0, 0], "write": [0, 0], "source": "manual" } ],
      "op": "supervise", "expect": [60, 63] },
    { "id": "sup-05", "covers": "supervision", "kind": "guard", "rule": "A held Fan Off is raised once the GPU's reads fail past the max age",
      "cpu": { "c": 40, "age": 0 }, "gpu": { "c": 45, "age": 46 }, "history": [ { "at": -46, "request": [0, 0], "write": [0, 0], "source": "manual" } ],
      "op": "supervise", "expect": [60, 63] },

    { "id": "pg-01", "covers": "panic-level", "kind": "guard", "rule": "In panic a manual write is raised to the panic level (60/63)",
      "cpu": { "c": 97, "age": 0 }, "history": [ { "panic": [60, 63] } ],
      "op": "filter", "level": [30, 30], "source": "manual", "expect": [60, 63] },
    { "id": "pg-02", "covers": "panic-level", "kind": "guard", "rule": "In panic a program write is raised to the panic level (52/55), with no curve on top",
      "cpu": { "c": 97, "age": 0 }, "history": [ { "panic": [52, 55] } ],
      "op": "filter", "level": [30, 30], "source": "program", "expect": [52, 55] },
    { "id": "pg-03", "covers": "panic-level", "kind": "guard", "rule": "Panic from automatic mode (nothing requested) is judged as manual: panic level and the curve",
      "cpu": { "c": 97, "age": 0 }, "history": [ { "panic": [52, 55] } ],
      "op": "supervise", "expect": [60, 63] },
    { "id": "pg-04", "covers": "panic-level", "kind": "guard", "rule": "The panic level is re-sent on every pass, even when unchanged",
      "cpu": { "c": 97, "age": 0 }, "history": [ { "at": -3, "request": [30, 30], "write": [52, 55], "source": "program" }, { "panic": [52, 55] } ],
      "op": "supervise", "expect": [52, 55] },
    { "id": "pg-05", "covers": "panic-level", "kind": "guard", "rule": "Panic beats cool: a manual 0/0 at 45 C in panic gets the panic level",
      "cpu": { "c": 45, "age": 0 }, "history": [ { "panic": [52, 55] } ],
      "op": "filter", "level": [0, 0], "source": "manual", "expect": [52, 55] },
    { "id": "pg-06", "covers": "panic-level", "kind": "guard", "rule": "After a program hand-back, a later panic is judged as manual (curve on top)",
      "cpu": { "c": 88, "age": 0 }, "gpu": { "c": 91, "age": 0 }, "history": [
        { "at": -60, "request": [30, 30], "write": [30, 30], "source": "program" },
        { "at": -30, "release": true },
        { "panic": [55, 55] } ],
      "op": "supervise", "expect": [60, 63] },
    { "id": "pg-07", "covers": "panic-level", "kind": "guard", "rule": "In panic a single 0xFF passes untouched: that fan is not raised",
      "cpu": { "c": 97, "age": 0 }, "history": [ { "panic": [52, 55] } ],
      "op": "filter", "level": [255, 30], "source": "manual", "expect": [255, 63],
      "disputed": "PLAN 3: panic raises every write to the fan-table maximum. The guard passes 0xFF ('no change') per fan before the panic, floor and curve checks, so [255, x] leaves the CPU fan at whatever it was (or, on 8BAC, sends 255 for one fan, whose meaning is unmeasured). Reachable from the CLI (FanLevel=255,0) and stored levels; FanArray only special-cases 255/255." },
    { "id": "pg-08", "covers": "no-change", "kind": "guard", "rule": "255/255 passes the filter untouched, however hot",
      "cpu": { "c": 90, "age": 0 }, "op": "filter", "level": [255, 255], "source": "manual", "expect": [255, 255] },
    { "id": "pg-09", "covers": "no-change", "kind": "guard", "rule": "A single 0xFF passes while warm; the other fan gets the floor and curve",
      "cpu": { "c": 60, "age": 0 }, "op": "filter", "level": [255, 0], "source": "manual", "expect": [255, 33] },

    { "id": "hbl-01", "covers": "handback-level", "kind": "guard", "rule": "Hand-back from a cool Fan Off leaves the floor, never 0/0",
      "cpu": { "c": 40, "age": 0 }, "history": [ { "at": -10, "request": [0, 0], "write": [0, 0], "source": "manual" } ],
      "op": "handBackLevel", "expect": [20, 22] },
    { "id": "hbl-02", "covers": "handback-level", "kind": "guard", "rule": "Hand-back keeps the last level when it is above the curve (45/48 at 75 C)",
      "cpu": { "c": 75, "age": 0 }, "history": [ { "at": -10, "request": [45, 48], "write": [45, 48], "source": "manual" } ],
      "op": "handBackLevel", "expect": [45, 48] },
    { "id": "hbl-03", "covers": "handback-level", "kind": "guard", "rule": "Hand-back while hot leaves at least the curve (45/48 at 82 C -> 60/63)",
      "cpu": { "c": 82, "age": 0 }, "history": [ { "at": -10, "request": [45, 48], "write": [45, 48], "source": "manual" } ],
      "op": "handBackLevel", "expect": [60, 63] },
    { "id": "hbl-04", "covers": "handback-level", "kind": "guard", "rule": "Hand-back with an unknown temperature leaves the top step",
      "history": [ { "at": -10, "request": [30, 33], "write": [30, 33], "source": "manual" } ],
      "op": "handBackLevel", "expect": [60, 63] },
    { "id": "hbl-05", "covers": "handback-level", "kind": "guard", "rule": "Hand-back from a program level keeps it when above the curve",
      "cpu": { "c": 65, "age": 0 }, "history": [ { "at": -10, "request": [35, 35], "write": [35, 35], "source": "program" } ],
      "op": "handBackLevel", "expect": [35, 35] },

    { "id": "quiet-01", "covers": "handback-silence", "kind": "guard", "rule": "No heartbeat 149 s after a hand-back",
      "history": [ { "at": -149, "release": true } ], "op": "heartbeatAllowed", "expect": false },
    { "id": "quiet-02", "covers": "handback-silence", "kind": "guard", "rule": "The heartbeat may run again 150 s after a hand-back",
      "history": [ { "at": -150, "release": true } ], "op": "heartbeatAllowed", "expect": true },
    { "id": "quiet-03", "covers": "handback-silence", "kind": "guard", "rule": "A new write ends the quiet period",
      "cpu": { "c": 60, "age": 0 }, "history": [ { "at": -10, "release": true }, { "at": -5, "request": [30, 30], "write": [30, 30], "source": "manual" } ],
      "op": "heartbeatAllowed", "expect": true },
    { "id": "quiet-04", "covers": "handback-silence", "kind": "guard", "rule": "After a hand-back nothing is held and supervision writes nothing",
      "cpu": { "c": 70, "age": 0 }, "history": [ { "at": -20, "request": [0, 0], "write": [0, 0], "source": "manual" }, { "at": -10, "release": true } ],
      "op": "supervise", "expect": null },
    { "id": "quiet-05", "covers": "handback-silence", "kind": "guard", "rule": "After a hand-back the guard holds no level",
      "history": [ { "at": -20, "request": [30, 30], "write": [30, 30], "source": "manual" }, { "at": -10, "release": true } ],
      "op": "holdsLevel", "expect": false },
    { "id": "quiet-06", "covers": "handback-silence", "kind": "guard", "rule": "The quiet period comes from the policy (200 s)",
      "policy": { "handBackQuietS": 200 }, "history": [ { "at": -160, "release": true } ], "op": "heartbeatAllowed", "expect": false },

    { "id": "panic-01", "covers": "panic-enter", "kind": "panic", "rule": "1 C below the threshold: no panic",
      "active": false, "hottest": 89, "expect": { "transition": "None", "active": false } },
    { "id": "panic-02", "covers": "panic-enter", "kind": "panic", "rule": "At the threshold: panic starts",
      "active": false, "hottest": 90, "expect": { "transition": "Entered", "active": true } },
    { "id": "panic-03", "covers": "panic-enter", "kind": "panic", "rule": "Above 100 C is a reading like any other: panic starts",
      "active": false, "hottest": 105, "threshold": 95, "hysteresis": 10, "expect": { "transition": "Entered", "active": true } },
    { "id": "panic-04", "covers": "panic-clear", "kind": "panic", "rule": "Active, 1 C above threshold - hysteresis: stays",
      "active": true, "hottest": 86, "expect": { "transition": "None", "active": true } },
    { "id": "panic-05", "covers": "panic-clear", "kind": "panic", "rule": "Active, at threshold - hysteresis: clears",
      "active": true, "hottest": 85, "expect": { "transition": "Cleared", "active": false } },
    { "id": "panic-06", "covers": "panic-clear", "kind": "panic", "rule": "A hysteresis at or above the threshold is clamped so the off point stays below it",
      "active": true, "hottest": 2, "threshold": 10, "hysteresis": 20, "expect": { "transition": "None", "active": true } },
    { "id": "panic-07", "covers": "panic-clear", "kind": "panic", "rule": "Clamped hysteresis: clears at 1 C",
      "active": true, "hottest": 1, "threshold": 10, "hysteresis": 20, "expect": { "transition": "Cleared", "active": false } },
    { "id": "panic-08", "covers": "panic-clear", "kind": "panic", "rule": "Turned off while active: ends quietly (Disabled)",
      "active": true, "enabled": false, "hottest": 99, "expect": { "transition": "Disabled", "active": false } },
    { "id": "panic-09", "covers": "panic-clear", "kind": "panic", "rule": "Turned off while inactive: nothing happens",
      "active": false, "enabled": false, "hottest": 99, "expect": { "transition": "None", "active": false } },
    { "id": "panic-10", "covers": "panic-missing", "kind": "panic", "rule": "Active, no reading: stays active",
      "active": true, "hottest": null, "expect": { "transition": "None", "active": true } },
    { "id": "panic-11", "covers": "panic-missing", "kind": "panic", "rule": "Inactive, no reading: stays inactive",
      "active": false, "hottest": null, "expect": { "transition": "None", "active": false } },
    { "id": "panic-12", "covers": "panic-missing", "kind": "panic", "rule": "An incomplete reading (GPU unknown) at the threshold starts panic",
      "active": false, "hottest": 90, "complete": false, "expect": { "transition": "Entered", "active": true },
      "note": "PLAN says a missing reading never changes the state; an incomplete one is a lower bound and may start panic (the safe direction)." },
    { "id": "panic-13", "covers": "panic-missing", "kind": "panic", "rule": "An incomplete reading below the threshold does not start panic",
      "active": false, "hottest": 89, "complete": false, "expect": { "transition": "None", "active": false } },
    { "id": "panic-14", "covers": "panic-missing", "kind": "panic", "rule": "An incomplete reading never clears panic, however low",
      "active": true, "hottest": 40, "complete": false, "expect": { "transition": "None", "active": true } },

    { "id": "b-zero-01", "covers": "zero-refused", "kind": "board", "rule": "Fan Off at 55 C: the board receives 20/22, never 0/0",
      "steps": [ { "cpu": 55 }, { "tick": true }, { "expect": {} },
                 { "off": true }, { "expect": { "writes": [[20, 22]], "measured": [20, 22] } } ] },
    { "id": "b-zero-02", "covers": "zero-refused", "kind": "board", "rule": "Fan Off at 42 C (known cool): the board receives 0/0 and the fans stop",
      "steps": [ { "cpu": 42 }, { "tick": true }, { "expect": {} },
                 { "off": true }, { "expect": { "writes": [[0, 0]], "measured": [0, 0] } } ],
      "note": "See zero-01: 0/0 reaches the board while known cool." },
    { "id": "b-zero-03", "covers": "supervision", "kind": "board", "rule": "Fan Off, then 56 C: the next pass raises it to the floor and arms the write itself",
      "steps": [ { "cpu": 42 }, { "tick": true }, { "off": true }, { "expect": { "writes": [[0, 0]] } },
                 { "heartbeatPaused": true }, { "advance": 60 }, { "cpu": 56 }, { "tick": true },
                 { "expect": { "calls": ["0x10", "0x10", "0x2E 20/22"], "measured": [20, 22] } } ] },
    { "id": "b-zero-04", "covers": "readings-stale", "kind": "board", "rule": "Fan Off, then every sensor fails: after the max age the next pass raises it (top step)",
      "steps": [ { "cpu": 40 }, { "tick": true }, { "off": true }, { "expect": { "writes": [[0, 0]] } },
                 { "ecFails": true }, { "biosFail": "0x23" }, { "advance": 45 }, { "tick": true }, { "expect": { "writes": [] } },
                 { "advance": 1 }, { "tick": true }, { "expect": { "writes": [[60, 63]], "measured": [60, 63] } } ] },
    { "id": "b-zero-05", "covers": "gpu-state", "kind": "board", "rule": "Fan Off with a GPU that read 45 C, then the EC lock fails: raised once the GPU is unknown",
      "steps": [ { "cpu": 40 }, { "gpu": 45 }, { "tick": true }, { "off": true }, { "expect": { "writes": [[0, 0]] } },
                 { "ecFails": true }, { "advance": 30 }, { "tick": true }, { "expect": { "writes": [] } },
                 { "advance": 16 }, { "tick": true }, { "expect": { "writes": [[60, 63]], "measured": [60, 63] } } ] },
    { "id": "b-zero-06", "covers": "gpu-state", "kind": "board", "rule": "Fan Off with a GPU that parks (reads 0): stays off, judged on the CPU",
      "steps": [ { "cpu": 40 }, { "gpu": 45 }, { "tick": true }, { "off": true }, { "expect": { "writes": [[0, 0]] } },
                 { "gpu": 0 }, { "ticks": 10, "interval": 10 }, { "expect": { "writes": [], "measured": [0, 0] } } ] },
    { "id": "b-zero-07", "covers": "readings-invalid", "kind": "board", "rule": "Sensors that read 0 C give no reading: Fan Off is raised when the last valid one ages out",
      "steps": [ { "cpu": 40 }, { "tick": true }, { "off": true }, { "expect": { "writes": [[0, 0]] } },
                 { "cpu": 0 }, { "advance": 45 }, { "tick": true }, { "expect": { "writes": [] } },
                 { "advance": 1 }, { "tick": true }, { "expect": { "writes": [[60, 63]] } } ] },
    { "id": "b-zero-08", "covers": "readings-invalid", "kind": "board", "rule": "Implausible reads (200 C) give no reading: Fan Off is raised when the last valid one ages out",
      "steps": [ { "cpu": 40 }, { "tick": true }, { "off": true }, { "expect": { "writes": [[0, 0]] } },
                 { "cpu": 200 }, { "advance": 46 }, { "tick": true }, { "expect": { "writes": [[60, 63]], "panic": false } } ] },
    { "id": "b-zero-09", "covers": "off-time-limit", "kind": "board", "rule": "Fan Off held while cool is raised to the floor after 15 min",
      "steps": [ { "cpu": 40 }, { "tick": true }, { "off": true }, { "expect": { "writes": [[0, 0]] } },
                 { "ticks": 29, "interval": 30 }, { "expect": { "writes": [], "measured": [0, 0] } },
                 { "ticks": 1, "interval": 30 }, { "expect": { "writes": [[20, 22]], "measured": [20, 22] } } ] },

    { "id": "b-arm-01", "covers": "arming", "kind": "board", "rule": "Every 0x2E goes out right after its own 0x10 (BiosCtl.SetFanLevel): a request takes effect without the heartbeat",
      "steps": [ { "heartbeatPaused": true }, { "cpu": 65 }, { "tick": true }, { "expect": {} },
                 { "set": [40, 40], "source": "manual" }, { "expect": { "calls": ["0x10", "0x2E 40/40"], "measured": [40, 40] } } ],
      "note": "The arm-before-set quirk lives in the BIOS adapter (BiosCtl.SetFanLevel), so FanArray.ArmFanLevel only adds a second 0x10 on this path (see b-arm-02)." },
    { "id": "b-arm-02", "covers": "arming", "kind": "board", "rule": "A safety raise arms itself: FanArray's 0x10, then BiosCtl's 0x10 and the 0x2E",
      "steps": [ { "cpu": 40 }, { "tick": true }, { "off": true }, { "expect": {} },
                 { "heartbeatPaused": true }, { "advance": 60 }, { "cpu": 75 }, { "tick": true },
                 { "expect": { "calls": ["0x10", "0x10", "0x2E 40/43"], "measured": [40, 43] } } ] },

    { "id": "b-hb-01", "covers": "handback-level", "kind": "board", "rule": "Hand-back from Fan Off: arm, the floor, then 255/255 (each 0x2E with its own 0x10)",
      "steps": [ { "cpu": 40 }, { "tick": true }, { "off": true }, { "expect": { "measured": [0, 0] } },
                 { "advance": 10 }, { "release": true },
                 { "expect": { "calls": ["0x10", "0x10", "0x2E 20/22", "0x10", "0x2E 255/255"], "measured": [20, 22], "heartbeatAllowed": false, "holds": false } } ],
      "disputed": "PLAN 3: hand-back = write a safe level, then no 0x2E and no 0x10. FanArray.Release sends 0x10 + 0x2E 255/255 right after the safe level (BiosCtl arms every 0x2E). On 8BAC PLAN says 255/255 restarts the ~124 s timer at the current speed, so this only moves the expiry by milliseconds; on boards where 255/255 means 'auto' it hands back at once. Either the plan's wording or the call should change; the simulated 8BAC (Fake8BacBios) also does not restart the timer on 255/255, unlike PLAN's measurement." },
    { "id": "b-hb-02", "covers": "handback-silence", "kind": "board", "rule": "After the hand-back: no 0x2E and no 0x10 for 150 s; the BIOS curve takes over; then the heartbeat resumes on its next 30 s slot",
      "steps": [ { "cpu": 40 }, { "tick": true }, { "off": true }, { "advance": 10 }, { "release": true }, { "expect": {} },
                 { "ticks": 14, "interval": 10 }, { "expect": { "calls": [], "measured": [24, 26], "heartbeatAllowed": false } },
                 { "ticks": 3, "interval": 10 }, { "expect": { "calls": ["0x10"], "heartbeatAllowed": true } } ] },
    { "id": "b-hb-03", "covers": "expiry", "kind": "board", "rule": "A level not refreshed expires 124 s after the last 0x2E/0x10 (simulated 8BAC)",
      "steps": [ { "cpu": 40 }, { "tick": true }, { "set": [40, 40], "source": "manual" }, { "release": true }, { "expect": { "measured": [40, 40] } },
                 { "advance": 123 }, { "expect": { "measured": [40, 40] } },
                 { "advance": 1 }, { "expect": { "measured": [24, 26] } } ] },
    { "id": "b-hb-04", "covers": "handback-silence", "kind": "board", "rule": "Hand-back with nothing held sends nothing (ReleaseIfHeld in automatic mode)",
      "steps": [ { "cpu": 60 }, { "tick": true }, { "expect": {} }, { "releaseIfHeld": true }, { "expect": { "calls": [] } } ] },
    { "id": "b-hb-05", "covers": "no-change", "kind": "board", "rule": "A 255/255 request is a hand-back: arm, the held level, 255/255, then quiet",
      "steps": [ { "cpu": 60 }, { "tick": true }, { "set": [40, 40], "source": "manual" }, { "expect": { "writes": [[40, 40]] } },
                 { "set": [255, 255], "source": "manual" },
                 { "expect": { "calls": ["0x10", "0x10", "0x2E 40/40", "0x10", "0x2E 255/255"], "heartbeatAllowed": false } } ] },
    { "id": "b-hb-06", "covers": "handback-level", "kind": "board", "rule": "Hand-back after it warmed to 82 C under Fan Off leaves at least the curve (60/63)",
      "steps": [ { "cpu": 40 }, { "tick": true }, { "off": true }, { "cpu": 82 }, { "sample": true }, { "expect": {} },
                 { "release": true }, { "expect": { "writes": [[60, 63], [255, 255]], "measured": [60, 63] } } ] },
    { "id": "b-hb-07", "covers": "handback-silence", "kind": "board", "rule": "Panic during the quiet period overrides the silence",
      "steps": [ { "cpu": 40 }, { "tick": true }, { "set": [30, 33], "source": "manual" }, { "release": true }, { "expect": {} },
                 { "advance": 20 }, { "cpu": 92 }, { "tick": true },
                 { "expect": { "writes": [[60, 63], [60, 63]], "measured": [60, 63], "panic": true, "heartbeatAllowed": true } } ] },

    { "id": "b-panic-01", "covers": "panic-enter", "kind": "board", "rule": "Panic within one pass: the pass that reads 90 C writes the panic level (automatic mode: table max and curve)",
      "steps": [ { "cpu": 89 }, { "tick": true }, { "expect": { "panic": false, "writes": [] } },
                 { "advance": 3 }, { "cpu": 90 }, { "tick": true },
                 { "expect": { "panic": true, "writes": [[60, 63], [60, 63]], "measured": [60, 63] } } ] },
    { "id": "b-panic-02", "covers": "panic-level", "kind": "board", "rule": "Panic over a program level: the fan-table maximum, re-sent every pass, the program restored on clear",
      "steps": [ { "cpu": 70 }, { "tick": true }, { "set": [35, 35], "source": "program" }, { "expect": { "writes": [[35, 35]] } },
                 { "advance": 3 }, { "cpu": 92 }, { "tick": true }, { "expect": { "panic": true, "writes": [[52, 55], [52, 55]], "measured": [52, 55] } },
                 { "advance": 3 }, { "cpu": 86 }, { "tick": true }, { "expect": { "panic": true, "writes": [[52, 55]] } },
                 { "advance": 3 }, { "cpu": 85 }, { "tick": true }, { "expect": { "panic": false, "writes": [[35, 35]] } } ] },
    { "id": "b-panic-03", "covers": "panic-clear", "kind": "board", "rule": "Panic from automatic mode clears into a hand-back",
      "steps": [ { "cpu": 92 }, { "tick": true }, { "expect": { "panic": true, "writes": [[60, 63], [60, 63]] } },
                 { "advance": 3 }, { "cpu": 85 }, { "tick": true },
                 { "expect": { "panic": false, "writes": [[60, 63], [255, 255]], "heartbeatAllowed": false } } ] },
    { "id": "b-panic-04", "covers": "panic-missing", "kind": "board", "rule": "Panic with every sensor failing: stays active and keeps writing the top level",
      "steps": [ { "cpu": 92 }, { "tick": true }, { "expect": { "panic": true } },
                 { "ecFails": true }, { "biosFail": "0x23" }, { "advance": 46 }, { "tick": true },
                 { "expect": { "panic": true, "writes": [[60, 63]], "measured": [60, 63] } } ] },
    { "id": "b-panic-05", "covers": "panic-missing", "kind": "board", "rule": "GPU unknown, BIOS CPU sensor at 92 C: the incomplete reading starts panic; at 50 C it does not clear it",
      "steps": [ { "cpu": 40 }, { "gpu": 50 }, { "tick": true }, { "expect": { "panic": false } },
                 { "ecFails": true }, { "cpu": 92 }, { "advance": 46 }, { "tick": true }, { "expect": { "panic": true, "writes": [[60, 63], [60, 63]] } },
                 { "cpu": 50 }, { "advance": 3 }, { "tick": true }, { "expect": { "panic": true } } ] },
    { "id": "b-panic-06", "covers": "panic-enter", "kind": "board", "rule": "A hot GPU alone (91 C, CPU 60 C) starts panic",
      "steps": [ { "cpu": 60 }, { "gpu": 91 }, { "tick": true }, { "expect": { "panic": true, "measured": [60, 63] } } ] },
    { "id": "b-panic-07", "covers": "panic-level", "kind": "board", "rule": "Fan table unreadable: the panic level falls back to at least the curve's top step (60/63)",
      "steps": [ { "biosFail": "0x2F" }, { "cpu": 70 }, { "tick": true }, { "set": [35, 35], "source": "program" }, { "expect": {} },
                 { "advance": 3 }, { "cpu": 92 }, { "tick": true }, { "expect": { "panic": true, "writes": [[60, 63], [60, 63]] } } ] },
    { "id": "b-panic-08", "covers": "panic-clear", "kind": "board", "rule": "Panic turned off while active: hand-back",
      "steps": [ { "cpu": 92 }, { "tick": true }, { "expect": { "panic": true } },
                 { "panicEnabled": false }, { "advance": 3 }, { "tick": true },
                 { "expect": { "panic": false, "writes": [[60, 63], [255, 255]] } } ] },
    { "id": "b-panic-09", "covers": "panic-enter", "kind": "board", "rule": "No CPU reading (both CPU sensors read 0) and a fresh GPU at 97 C: panic starts on the GPU reading (an incomplete reading may start panic, never end it)",
      "steps": [ { "cpu": 40 }, { "tick": true }, { "expect": { "panic": false } },
                 { "cpu": 0 }, { "gpu": 97 }, { "advance": 46 }, { "tick": true },
                 { "expect": { "panic": true, "writes": [[60, 63], [60, 63]], "measured": [60, 63] } } ] }
  ]
}
