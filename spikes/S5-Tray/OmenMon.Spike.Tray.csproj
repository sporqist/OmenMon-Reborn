<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spike S5, tray half (PLAN.md section 7, phase 0): a minimal WinForms tray icon.
       Not part of OmenMon.sln. Publish only; see README.md. WinForms does not support
       NativeAOT, so this is a framework-dependent (JIT) app on the shared .NET 10 runtime. -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <RootNamespace>OmenMon.Spikes.Tray</RootNamespace>
    <AssemblyName>OmenMon.Spike.Tray</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
