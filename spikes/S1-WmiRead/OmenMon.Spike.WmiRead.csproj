<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spike S1 (PLAN.md section 7, phase 0): read-only BIOS WMI from a NativeAOT exe.
       Not part of OmenMon.sln. Publish only; see README.md. -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>OmenMon.Spikes.WmiRead</RootNamespace>
    <AssemblyName>OmenMon.Spike.WmiRead</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Reading hpqBIntM needs an elevated token -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

</Project>
