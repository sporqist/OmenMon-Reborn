<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <!-- <AllowUnsafeBlocks>true</AllowUnsafeBlocks> -->
    <ApplicationIcon>Resources\Icon.ico</ApplicationIcon>
    <ApplicationManifest>OmenMon.manifest</ApplicationManifest>
    <AssemblyName>OmenMon</AssemblyName>
    <AssemblyVersionFile>All\Version.cs</AssemblyVersionFile>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Deterministic>true</Deterministic>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <ErrorReport>prompt</ErrorReport>
    <LangVersion>latest</LangVersion>
    <OutputPath>Bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputType>WinExe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <ProjectGuid>{F6104868-81A7-4D09-8AD2-8CF261D58319}</ProjectGuid>
    <RootNamespace>OmenMon</RootNamespace>
    <StartupObject>OmenMon.App</StartupObject>
    <WarningLevel>4</WarningLevel>
    <!-- Assembly attributes come from All\Meta.cs and All\Version.cs (or the AddVersion target below) -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- OmenMon.exe.config is deliberately not deployed (see the file), so do not generate one -->
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">1.4.11.0</AssemblyVersion>
    <AssemblyVersionWord Condition="'$(AssemblyVersionWord)' == ''">reborn</AssemblyVersionWord>
    <!-- The test project lives below this directory; keep its sources out of the default globs -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests\**;wiki\**;docs\**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reference assemblies so net48 builds without the targeting pack installed -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <!-- Ships with Windows (GAC); the SDK does not search the GAC, so point at it directly -->
    <Reference Include="Microsoft.Management.Infrastructure">
      <HintPath>$(WINDIR)\Microsoft.NET\assembly\GAC_MSIL\Microsoft.Management.Infrastructure\v4.0_1.0.0.0__31bf3856ad364e35\Microsoft.Management.Infrastructure.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <!-- Accessor class is All\Resources.cs; all entries are byte arrays (no BinaryFormatter) -->
    <EmbeddedResource Update="OmenMon.resx">
      <LogicalName>OmenMon.Resources.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\LpcACPIEC.bin" Condition="Exists('Resources\LpcACPIEC.bin')">
      <LogicalName>OmenMon.LpcACPIEC.bin</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <!-- <ItemGroup>
        <ProjectReference Include="Driver.csproj">
            <Project>{10ADAB1E-11B1-ABE1-5ACC-E551B1EAB0DE}</Project>
            <Name>Driver</Name>
        </ProjectReference>
    </ItemGroup> -->
  <Target Name="AddVersion" BeforeTargets="CoreCompile" Condition="'$(AssemblyVersion)'!='' And '$(AssemblyVersionWord)'!=''">
    <Error Condition="'$([System.Text.RegularExpressions.Regex]::IsMatch(&quot;$(AssemblyVersion)&quot;, &quot;^\d+\.\d+\.\d+\.\d+$&quot;))' == false" Text="Assembly version must consist of exactly four non-negative integers separated by dots" />
    <Message Text="Assembly Version: $(AssemblyVersion)-$(AssemblyVersionWord)" />
    <ReadLinesFromFile File="$(AssemblyVersionFile)">
      <Output TaskParameter="Lines" ItemName="AssemblyVersionLines" />
    </ReadLinesFromFile>
    <ItemGroup>
      <GeneratedVersionLines Include="@(AssemblyVersionLines)" Condition="'$([System.Text.RegularExpressions.Regex]::IsMatch(&quot;%(Identity)&quot;, &quot;(?i)Assembly((File|Informational)?Version|Metadata)&quot;))' == false" />
      <GeneratedVersionLines Include="[assembly: AssemblyVersion(&quot;$([System.Text.RegularExpressions.Regex]::Match($(AssemblyVersion), `\d+\.\d+\.\d+`))&quot;)]" />
      <GeneratedVersionLines Include="[assembly: AssemblyFileVersion(&quot;$(AssemblyVersion)&quot;)]" />
      <GeneratedVersionLines Include="[assembly: AssemblyInformationalVersion(&quot;$([System.Text.RegularExpressions.Regex]::Match($(AssemblyVersion), `\d+\.\d+\.\d+`))-$(AssemblyVersionWord)&quot;)]" />
      <GeneratedVersionLines Include="[assembly: AssemblyMetadata(&quot;Timestamp&quot;, &quot;$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm'))&quot;)]" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)Version.cs" Lines="@(GeneratedVersionLines)" Overwrite="true" />
    <ItemGroup>
      <Compile Remove="$(AssemblyVersionFile)" />
      <Compile Include="$(IntermediateOutputPath)Version.cs" />
    </ItemGroup>
  </Target>
  <Target Name="EnsurePawnBlobForRelease" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release'">
    <Error Condition="!Exists('Resources/LpcACPIEC.bin')" Text="Missing required file: Resources/LpcACPIEC.bin. Follow Resources/PAWN_BUILD.md to fetch/build it before creating a Release build." />
  </Target>
  <Target Name="BuildComplete" AfterTargets="AfterBuild">
    <Copy SourceFiles="OmenMon.xml" DestinationFolder="$(OutDir)" />
    <!-- <Exec Command="robocopy /nc /ndl /nfl /njh /njs /np /ns /r:2 /w:5 Bin \\Momentum\Exchange\ OmenMon.*" IgnoreExitCode="true" /> -->
  </Target>
  <Target Name="DeleteDirs" AfterTargets="Clean">
    <RemoveDir Directories="$(IntermediateOutputPath)" />
    <RemoveDir Directories="$(OutputPath)" />
  </Target>
</Project>
